# Copy to .env and fill in your own keys

# api.data.gov key for api.fac.gov (https://api.data.gov/signup/)
FAC_API_KEY=
# SAM.gov public Entity Management API key (SAM.gov profile > API key)
SAM_API_KEY=

# Local SQLite database built by scripts/build_db.py (default data/dat.sqlite)
# DAT_DB_PATH=
